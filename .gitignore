# Local .terraform directories
.terraform/
.dev.vars
# Terraform state files and backups
*.tfstate
*.tfstate.*
terraform.tfstate.*
terraform.tfstate
*.tfstate.backup
terraform.tfstate.backup

# Terraform plan output
*.tfplan

# Override files (for local settings)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable definition files. *.tfvars is gitignored by default — only
# the per-environment files under envs/ are committed (and have all sensitive
# values stripped; secrets flow in via TF_VAR_* env from GitHub Environment secrets).
*.tfvars
!envs/*.tfvars
envs/testing.tfvars
terraform.tfvars

# Terraform lock file (optional: remove if you want deterministic builds)
.terraform.lock.hcl

# Crash log files
crash.log
# IDE directories
.idea/
.vscode/
.cursor/
.antigravity/
.history/

node_modules/
.env
.env-*
.env.*
repomix*
.repomix*
.repomixignore

dist/
/dist
# Terragrunt cache and logs
.terragrunt-cache/
.terragrunt-debug.log

# Terragrunt configuration files (if containing secrets)
*.hcl
terragrunt.hcl
# Wrangler build and cache files
.wrangler/
.wrangler-config/
.wrangler-state.json
.wrangler.toml.local
wrangler.toml.local
wranglerjs/
wrangler-out/
wrangler-build/
wrangler-debug.log
